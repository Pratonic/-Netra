    "permissions": {"Version":"2012-10-17","Statement":[
      {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem","dynamodb:UpdateItem","dynamodb:DeleteItem","dynamodb:Query"],"Resource":"arn:aws:dynamodb:us-east-1:010526260400:table/AegisCampus"},
      {"Effect":"Allow","Action":["logs:CreateLogStream","logs:PutLogEvents"],"Resource":"arn:aws:logs:us-east-1:010526260400:log-group:/aws/lambda/AegisCampusService:*"},
      {"Effect":"Allow","Action":["rekognition:CreateFaceLivenessSession","rekognition:GetFaceLivenessSessionResults","rekognition:CompareFaces"],"Resource":"*"},
      {"Effect":"Allow","Action":"sts:AssumeRole","Resource":"arn:aws:iam::010526260400:role/AegisLivenessStream"}
